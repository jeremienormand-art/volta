// Mise en ligne sur Cloudflare (Workers avec fichiers statiques).
// Le dépôt est branché sur Cloudflare : chaque enregistrement sur `main` publie le jeu.
// « name » doit rester identique au nom du Worker dans le tableau de bord Cloudflare.
// Tout ce qui est dans `dist/` est public : n'y mettre que le jeu.
{
  "name": "volta",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Classement : base D1 `volta-scores` sur le compte Cloudflare d'Anaïs (6 novembre 2026)
  "d1_databases": [{ "binding": "DB", "database_name": "volta-scores", "database_id": "dd74cc0b-7486-49f7-8050-aca1bd5c3cc7" }],
  // v1.30 : anti-triche. « observer » : chaque partie classée est rejouée après la réponse et notée (bilan : /api/rejeu) ;
  // « exiger » : score refusé si le rejeu ne donne pas le même ; « off » : pas de rejeu.
  "vars": { "REJEU": "observer" },
  "observability": { "enabled": true }
}
